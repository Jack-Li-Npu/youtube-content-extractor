# Optional proxy for backend YouTube requests. Leave empty for normal access.
# Other proxy variables from your shell may still apply; see README.md.
YT_PROXY=
# Example: YT_PROXY=http://127.0.0.1:7890

# Optional Douyin settings. Defaults use a dedicated local browser profile and
# the runtime/model installed by setup-douyin.sh. Never paste cookies here.
# DOUYIN_BROWSER_PROFILE=/absolute/path/to/dedicated-profile
# STT_PYTHON=/absolute/path/to/stt/.venv/bin/python
# STT_MODEL_DIR=/absolute/path/to/local/whisper-turbo
